# Deployment mode: demo (default) | live
# Public hosting should use demo or leave this unset. Do not put OpenAI keys on the demo host.
SECONDLOOK_DEPLOYMENT_MODE=demo

# Live local development only (ignored in demo mode; never required for the public demo)
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional. Server-side OpenAI request deadline in milliseconds (5_000–60_000). Default 30000.
OPENAI_TIMEOUT_MS=
# Optional. Set to 1 for local server diagnostics (elapsed ms, model, timeout, outcome, token counts). Never logs message content.
OPENAI_ANALYZE_DIAGNOSTICS=
